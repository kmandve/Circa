# Copy to .env and fill in. See docs/SETUP.md.

# --- Google OAuth (from console.cloud.google.com/apis/credentials) ---------
# IMPORTANT: publish the consent screen to "In production" or refresh tokens
# expire after 7 days.
CIRCA_GOOGLE_CLIENT_ID=
CIRCA_GOOGLE_CLIENT_SECRET=

# --- Location: a static setting, NOT location tracking ---------------------
# Used only for solar elevation in the light proxy, so the step->light estimate
# has a physical daylight ceiling. Your nearest city is precise enough; Circa
# never reads your device location. Example values below - replace them.
CIRCA_TIMEZONE=Europe/London
CIRCA_LATITUDE=51.5072
CIRCA_LONGITUDE=-0.1276

# --- Storage ---------------------------------------------------------------
# Defaults to /var/lib/circa if writable, else ~/.circa
# CIRCA_DATA_DIR=/var/lib/circa

# --- At-rest encryption for the refresh token ------------------------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key is generated into <data_dir>/secret.key with 0600 perms.
# Set it explicitly in production so the key does not sit next to the database.
# CIRCA_SECRET_KEY=

# --- Polling ---------------------------------------------------------------
# CIRCA_POLL_INTERVAL_MINUTES=15
# CIRCA_INITIAL_BACKFILL_DAYS=90

# --- Retention (keeps the database ~50 MB/year) ----------------------------
# CIRCA_RAW_PAYLOAD_RETENTION_DAYS=30
# CIRCA_HR_SAMPLE_RETENTION_DAYS=90

# --- Web -------------------------------------------------------------------
# CIRCA_WEB_HOST=127.0.0.1
# CIRCA_WEB_PORT=8720
# CIRCA_LOG_LEVEL=INFO
